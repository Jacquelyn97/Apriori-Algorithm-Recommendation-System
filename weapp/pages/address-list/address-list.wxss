/* pages/address-list/address-list.wxss */
.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 160rpx; }
.navBar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 12rpx; background: #fff; border-bottom: 1rpx solid #eee; box-sizing: content-box; }
.navLeft { min-width: 80rpx; }
.navBack { font-size: 56rpx; color: #333; font-weight: 300; }
.navTitle { font-size: 36rpx; font-weight: 700; color: #333; }
.navRight { min-width: 80rpx; }
.scroll { padding: 32rpx 24rpx; box-sizing: border-box; }
.scrollInner { max-width: 700rpx; margin: 0 auto; }
.actionRow { display: flex; align-items: center; justify-content: flex-end; gap: 24rpx; margin-bottom: 16rpx; }
.actionBtn { font-size: 28rpx; font-weight: 700; padding: 16rpx 22rpx; border-radius: 999rpx; background: #fff; border: 2rpx solid #ddd; color: #333; }
.actionBtn.primary { border-color: #ff9500; color: #ff9500; }
.actionBtn.danger { border-color: #e53935; color: #e53935; }
.card { display: flex; align-items: center; background: #fff; padding: 32rpx; margin-bottom: 2rpx; border-bottom: 1rpx solid #e0e0e0; }
.cardMain { flex: 1; }
.region { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 8rpx; display: block; }
.street { font-size: 28rpx; color: #666; margin-bottom: 16rpx; display: block; }
.nameRow { display: flex; align-items: center; flex-wrap: wrap; }
.name { font-size: 28rpx; color: #333; }
.phone { font-size: 28rpx; color: #666; }
.defaultTag { margin-left: 16rpx; background: #ff9500; padding: 4rpx 16rpx; border-radius: 20rpx; }
.defaultText { font-size: 22rpx; color: #fff; font-weight: 700; }
.radioWrap { margin-left: 24rpx; }
.radioEmpty { width: 44rpx; height: 44rpx; border-radius: 22rpx; border: 2rpx solid #ccc; }
.radioChecked { width: 44rpx; height: 44rpx; border-radius: 22rpx; background: #ff9500; display: flex; align-items: center; justify-content: center; }
.radioCheck { font-size: 24rpx; color: #fff; font-weight: 800; }
.cardManage { display: flex; align-items: flex-start; background: #fff; padding: 32rpx; border-bottom: 1rpx solid #e0e0e0; }
.checkboxWrap { margin-right: 24rpx; margin-top: 4rpx; }
.checkboxEmpty { width: 44rpx; height: 44rpx; border-radius: 8rpx; border: 2rpx solid #ccc; }
.checkboxChecked { width: 44rpx; height: 44rpx; border-radius: 8rpx; background: #ff9500; display: flex; align-items: center; justify-content: center; }
.checkboxCheck { font-size: 24rpx; color: #fff; font-weight: 800; }
.cardManageMain { flex: 1; }
.topRow { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.editIconWrap { padding: 8rpx; }
.editIcon { font-size: 32rpx; color: #666; }
.defaultRow { display: flex; align-items: center; }
.defaultDeleteRow { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.defaultLabel { font-size: 26rpx; color: #666; margin-right: 12rpx; }
.defaultCheckWrap { width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #ffcc00; display: flex; align-items: center; justify-content: center; }
.defaultCheck { font-size: 22rpx; color: #333; font-weight: 800; }
.deleteBtn { padding: 12rpx 24rpx; }
.deleteBtnText { font-size: 28rpx; color: #666; font-weight: 600; }
.endHint { text-align: center; color: #999; font-size: 26rpx; margin-top: 48rpx; display: block; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 24rpx 32rpx; border-top: 1rpx solid #eee; }
.selectAllRow { display: flex; align-items: center; gap: 16rpx; }
.selectAllText { font-size: 30rpx; color: #333; font-weight: 600; }
.bulkDeleteBtn { background: #e53935; padding: 20rpx 48rpx; border-radius: 16rpx; color: #fff; font-size: 30rpx; font-weight: 700; }
.bulkDeleteBtn.disabled { background: #ccc; opacity: 0.8; }
