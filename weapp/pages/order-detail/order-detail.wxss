/* pages/order-detail/order-detail.wxss */
.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 160rpx; }
.navBar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 12rpx; background: #fff; border-bottom: 1rpx solid #eee; box-sizing: content-box; }
.navLeft { min-width: 80rpx; }
.navBack { font-size: 56rpx; color: #333; font-weight: 300; }
.navTitle { font-size: 36rpx; font-weight: 700; color: #333; }
.navRight { min-width: 80rpx; }
.scroll { padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }
.scrollInner { max-width: 700rpx; margin: 0 auto; }
.statusBanner { margin: 24rpx 0; border-radius: 24rpx; padding: 36rpx; text-align: center; }
.statusText { font-size: 32rpx; font-weight: 800; color: #fff; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.sectionTitle { font-size: 30rpx; font-weight: 800; color: #333; margin-bottom: 24rpx; display: block; }
.detailItemRow { display: flex; align-items: center; margin-bottom: 24rpx; }
.detailThumb { width: 104rpx; height: 104rpx; border-radius: 16rpx; overflow: hidden; margin-right: 20rpx; background: #eee; }
.detailThumbImg { width: 100%; height: 100%; }
.detailThumbPlaceholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #999; }
.detailItemInfo { flex: 1; }
.detailItemName { font-size: 28rpx; color: #333; font-weight: 600; }
.detailItemRight { text-align: right; }
.detailItemQty { font-size: 24rpx; color: #666; display: block; margin-bottom: 4rpx; }
.detailItemPrice { font-size: 28rpx; color: #333; font-weight: 700; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.rowLabel { font-size: 26rpx; color: #666; }
.rowValue { font-size: 26rpx; color: #333; }
.rowValueHighlight { font-size: 26rpx; color: #ff9500; font-weight: 700; }
.emptyWrap { display: flex; align-items: center; justify-content: center; padding: 80rpx; }
.emptyText { font-size: 28rpx; color: #999; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #eee; padding: 24rpx; }
.payBtn { background: #ffcc00; border-radius: 44rpx; padding: 24rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: 800; }
