/* pages/address-form/address-form.wxss */
.container { min-height: 100vh; background: #f5f5f5; }
.navBar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 12rpx; background: #fff; border-bottom: 1rpx solid #eee; box-sizing: content-box; }
.navLeft { min-width: 80rpx; }
.navBack { font-size: 56rpx; color: #333; }
.navTitle { font-size: 36rpx; font-weight: 700; color: #333; }
.navRight { min-width: 80rpx; }
.scroll { padding: 32rpx 24rpx; box-sizing: border-box; }
.scrollInner { max-width: 700rpx; margin: 0 auto; }
.label { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; margin-top: 24rpx; display: block; }
.input { height: 88rpx; background: #fff; border-radius: 20rpx; padding: 0 24rpx; font-size: 30rpx; border: 1rpx solid #eee; margin-bottom: 8rpx; }
.row { display: flex; align-items: center; justify-content: space-between; margin-top: 40rpx; }
.btn { margin-top: 48rpx; background: #ff9500; border-radius: 44rpx; padding: 28rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: 700; }
