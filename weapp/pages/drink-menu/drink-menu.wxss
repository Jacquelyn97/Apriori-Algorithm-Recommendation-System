/* pages/drink-menu/drink-menu.wxss */
.container { height: 100vh; display: flex; flex-direction: column; background-color: #f8f8f8; }
.header { background: #fff; padding: 40rpx 24rpx 20rpx; border-bottom: 1rpx solid #eee; }
.headerRow { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.storeText { font-size: 36rpx; color: #333; }
.modeWrap { display: flex; background: #f0f0f0; border-radius: 999rpx; padding: 4rpx; }
.modeBtn { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 24rpx; color: #666; }
.modeBtnActive { background: rgb(174,127,85); color: #fff; font-weight: 600; }
.couponRow { display: flex; justify-content: space-between; align-items: center; }
.couponTags { display: flex; gap: 16rpx; }
.couponTag { font-size: 22rpx; color: #e53935; background: #fff; border: 1rpx solid #e53935; padding: 6rpx 14rpx; border-radius: 8rpx; }
.couponLink { font-size: 24rpx; color: #07c160; font-weight: 600; }
.navRow { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.navTabs { display: flex; align-items: center; margin-right: 16rpx; flex-shrink: 0; }
.navTab { font-size: 28rpx; color: #333; padding: 10rpx 16rpx; position: relative; }
.navTabActive { color: #e53935; font-weight: 700; }
.navTabActive::after { content: ''; position: absolute; left: 16rpx; right: 16rpx; bottom: 0; height: 4rpx; background: #e53935; }
.searchBar { flex: 1; min-width: 180rpx; height: 60rpx; background: #f5f5f5; border-radius: 30rpx; padding: 0 24rpx; font-size: 26rpx; }
.contentWrap { flex: 1; min-height: 0; overflow: hidden; width: 100%; display: flex; flex-direction: column; }
.bodyRow { flex: 1; display: flex; flex-direction: row; background: #f8f8f8; padding-bottom: 160rpx; min-height: 0; overflow: hidden; height: 0; }
.categoryWrap { width: 176rpx; flex-shrink: 0; height: 100%; min-height: 0; background: #f0f0f0; border-right: 1rpx solid #e0e0e0; }
.categoryCol { width: 100%; height: 100%; min-height: 0; background: #f0f0f0; box-sizing: border-box; }
.categoryItem { padding: 24rpx 12rpx; text-align: center; font-size: 26rpx; color: #555; }
.categoryItemActive { background: #fff; border-left: 6rpx solid #e53935; color: #e53935; font-weight: 700; }
.categoryText { display: inline-block; max-width: 140rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.productWrap { flex: 1; height: 100%; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
.productCol { flex: 1; width: 100%; min-height: 0; padding: 16rpx 16rpx 0 12rpx; background: #fff; box-sizing: border-box; }
.sectionHeaderRow { padding: 16rpx 0 12rpx; }
.sectionHeaderMain { font-size: 30rpx; font-weight: 700; color: #333; }
.sectionBlock { padding-bottom: 24rpx; }
.productList { padding-bottom: 8rpx; }
.productRow { display: flex; align-items: center; background: #fff; border-radius: 24rpx; padding: 16rpx; margin-bottom: 16rpx; }
.productImgWrap { width: 160rpx; height: 160rpx; border-radius: 20rpx; overflow: hidden; background: #eee; margin-right: 16rpx; }
.productImg { width: 100%; height: 100%; }
.productImgPlaceholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.placeholderText { font-size: 24rpx; color: #999; }
.productInfo { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.productName { font-size: 30rpx; color: #333; margin-bottom: 8rpx; }
.productPrice { font-size: 28rpx; color: rgb(174,127,85); font-weight: 700; }
.productAdd { width: 52rpx; height: 52rpx; border-radius: 26rpx; border: 2rpx solid rgb(174,127,85); display: flex; align-items: center; justify-content: center; margin-left: 12rpx; }
.productAddText { font-size: 36rpx; color: rgb(174,127,85); line-height: 36rpx; }
.emptyRow { padding: 24rpx; text-align: center; }
.emptyText { font-size: 28rpx; color: #999; }
.tabPanel { flex: 1; min-height: 0; overflow-y: auto; padding: 24rpx; padding-bottom: 160rpx; background: #f8f8f8; }
.reviewScroll { height: 100%; }
.reviewItem { display: flex; flex-direction: row; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.reviewAvatar { width: 96rpx; height: 96rpx; border-radius: 48rpx; margin-right: 24rpx; }
.reviewContent { flex: 1; display: flex; flex-direction: column; }
.reviewHeader { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.reviewName { font-size: 28rpx; color: #333; font-weight: 600; }
.reviewDate { font-size: 24rpx; color: #b0b0b0; }
.reviewStars { display: flex; margin-bottom: 8rpx; }
.reviewStar { font-size: 24rpx; color: #f5a623; margin-right: 4rpx; }
.reviewText { font-size: 26rpx; color: #666; line-height: 1.6; }
.placeholderCard { background: #fff; border-radius: 24rpx; padding: 48rpx; text-align: center; }
.placeholderTitle { font-size: 32rpx; font-weight: 700; color: #333; display: block; margin-bottom: 16rpx; }
.placeholderDesc { font-size: 28rpx; color: #999; }
.storeCard { background: #fff; border-radius: 24rpx; padding: 32rpx; }
.storeCardTitle { font-size: 32rpx; font-weight: 700; color: #333; display: block; margin-bottom: 24rpx; }
.storeItem { padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.storeItem:last-child { border-bottom: none; }
.storeName { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 8rpx; }
.storeAddr { font-size: 24rpx; color: #666; }
.reviewMoreRow { padding: 32rpx 0; align-items: center; justify-content: center; display: flex; }
.reviewMoreText { font-size: 26rpx; color: rgb(174,127,85); }
.storeScroll { height: 100%; }
.storeBlock { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.storeSectionHead { display: flex; align-items: center; margin-bottom: 24rpx; }
.storeSectionBar { width: 8rpx; height: 32rpx; background: rgb(174,127,85); border-radius: 4rpx; margin-right: 16rpx; }
.storeSectionTitle { font-size: 30rpx; font-weight: 700; color: #333; }
.deliveryRow { display: flex; align-items: center; margin-bottom: 20rpx; }
.deliveryRow:last-child { margin-bottom: 0; }
.deliveryLabel { font-size: 24rpx; color: #999; background: #f5f5f5; padding: 10rpx 20rpx; border-radius: 8rpx; margin-right: 24rpx; min-width: 80rpx; text-align: center; }
.deliveryValue { font-size: 28rpx; color: #333; }
.storeInfoRow { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.storeInfoRow:last-child { margin-bottom: 0; }
.storeInfoIcon { width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 16rpx; margin-top: 4rpx; }
.storeInfoText { font-size: 26rpx; color: #333; line-height: 1.5; flex: 1; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; background: #f5f5f5; padding: 24rpx; border-top: 1rpx solid #eee; }
.cartInfo { flex: 1; display: flex; align-items: center; }
.cartIcon { width: 48rpx; height: 48rpx; margin-right: 16rpx; }
.cartLabel { font-size: 28rpx; color: #333; }
.submitBtn { padding: 28rpx 48rpx; background: rgb(174,127,85); color: #fff; font-weight: 700; border-radius: 44rpx; }
.submitBtn.disabled { opacity: 0.5; }
