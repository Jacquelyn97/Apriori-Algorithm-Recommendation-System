/* pages/product-detail/product-detail.wxss */
.container { min-height: 100vh; background: #f5f5f5; }
.scroll { padding: 32rpx 24rpx 60rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin: 0 auto 24rpx; max-width: 680rpx; box-sizing: border-box; }
.hero { display: flex; justify-content: center; margin-bottom: 24rpx; }
.heroImg { width: 100%; max-width: 640rpx; height: 400rpx; border-radius: 24rpx; }
.heroPlaceholder { width: 100%; max-width: 640rpx; height: 400rpx; border-radius: 24rpx; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #999; }
.name { font-size: 40rpx; font-weight: 700; margin-bottom: 16rpx; display: block; }
.labelSmall { font-size: 24rpx; color: #999; font-weight: 600; margin-top: 12rpx; margin-bottom: 4rpx; display: block; }
.desc { font-size: 28rpx; color: #666; margin-bottom: 16rpx; display: block; }
.tagline { font-size: 28rpx; color: #b45309; font-style: italic; margin-bottom: 16rpx; display: block; }
.price { font-size: 44rpx; color: #07c160; font-weight: 700; display: block; }
.selected { margin-top: 20rpx; font-size: 24rpx; color: #666; font-weight: 700; display: block; }
.sectionTitle { margin-top: 12rpx; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 800; color: #333; display: block; }
.chips { display: flex; flex-wrap: wrap; gap: 20rpx; }
.chip { padding: 16rpx 24rpx; border-radius: 999rpx; background: #f3f3f3; font-size: 24rpx; font-weight: 800; color: #333; }
.chip.active { background: #07c160; color: #fff; }
.variantRow { display: flex; align-items: center; margin-top: 24rpx; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; }
.variantThumb { width: 112rpx; height: 112rpx; border-radius: 56rpx; overflow: hidden; margin-right: 24rpx; background: #eee; }
.variantThumbImg { width: 100%; height: 100%; }
.variantPlaceholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #999; }
.variantInfo { flex: 1; }
.variantName { font-size: 30rpx; font-weight: 700; color: #333; display: block; }
.variantPrice { font-size: 28rpx; color: #07c160; font-weight: 700; margin-top: 4rpx; display: block; }
.stepper { display: flex; align-items: center; margin-top: 8rpx; }
.stepBtn { width: 64rpx; height: 64rpx; border-radius: 32rpx; border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 900; color: #333; }
.stepBtn.disabled { opacity: 0.4; }
.qty { margin: 0 32rpx; font-size: 32rpx; font-weight: 600; }
.qtyRow { display: flex; justify-content: space-between; align-items: center; }
.label { font-size: 32rpx; font-weight: 600; }
.btn { margin-top: 32rpx; background: #07c160; border-radius: 48rpx; padding: 28rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: 600; }
.btn.disabled { background: #ccc; opacity: 0.8; }
