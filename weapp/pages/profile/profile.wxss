/* pages/profile/profile.wxss */
.scroll { height: 100vh; background: #f5f5f5; padding-bottom: 48rpx; }
.header { background: #fff; padding: 40rpx 32rpx 24rpx; border-bottom: 1rpx solid #eee; }
.headerTitle { font-size: 36rpx; font-weight: 800; color: #333; text-align: center; }
.memberCard { background: #222; border-radius: 32rpx; padding: 32rpx; margin: 24rpx; margin-top: 24rpx; }
.memberTopRow { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.memberUserRow { display: flex; align-items: center; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 48rpx; margin-right: 24rpx; }
.nameRow { display: flex; align-items: center; margin-bottom: 8rpx; }
.username { font-size: 32rpx; color: #fff; font-weight: 700; margin-right: 12rpx; }
.genderIcon { width: 36rpx; height: 36rpx; }
.cardNo { font-size: 26rpx; color: #f5f5f5; }
.qrIcon { width: 56rpx; height: 56rpx; }
.memberBottomRow { display: flex; justify-content: space-between; align-items: center; }
.memberTag { font-size: 24rpx; color: #f5f5f5; }
.moreText { font-size: 24rpx; color: #ffcc00; font-weight: 700; }
.vipStrip { background: #002b40; border-radius: 24rpx; padding: 24rpx 32rpx; margin: 0 24rpx 24rpx; display: flex; justify-content: space-between; align-items: center; }
.vipLeft { display: flex; align-items: center; }
.vipIcon { width: 56rpx; height: 56rpx; margin-right: 20rpx; }
.vipTitle { font-size: 28rpx; color: #fff; font-weight: 700; display: block; }
.vipSubTitle { font-size: 22rpx; color: #e0f0ff; margin-top: 4rpx; display: block; }
.vipBtn { background: #ffcc00; border-radius: 32rpx; padding: 12rpx 32rpx; }
.vipBtnText { font-size: 26rpx; color: #333; font-weight: 700; }
.summaryRow { display: flex; background: #fff; border-radius: 24rpx; margin: 0 24rpx 24rpx; padding: 24rpx 0; }
.summaryItem { flex: 1; text-align: center; }
.summaryIcon { width: 40rpx; height: 40rpx; margin-bottom: 8rpx; display: block; margin-left: auto; margin-right: auto; }
.summaryNumber { font-size: 32rpx; font-weight: 800; color: #333; display: block; margin-bottom: 4rpx; }
.summaryLabel { font-size: 24rpx; color: #666; }
.menuCard { background: #fff; border-radius: 24rpx; margin: 0 24rpx; padding: 8rpx 24rpx; }
.menuRow { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #eee; }
.menuLeft { display: flex; align-items: center; }
.menuIcon { width: 44rpx; height: 44rpx; margin-right: 20rpx; }
.menuText { font-size: 28rpx; color: #333; }
.menuArrow { font-size: 36rpx; color: #999; }
