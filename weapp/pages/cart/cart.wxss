/* pages/cart/cart.wxss */
.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 220rpx; }

/* 自定义导航栏：左侧仅显示 < 返回 */
.navBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  box-sizing: content-box;
}
.navLeft { min-width: 80rpx; }
.navBack { font-size: 40rpx; font-weight: 700; color: #333; }
.navTitle { font-size: 36rpx; font-weight: 700; color: #000; }
.navRight { min-width: 80rpx; }

.topBar { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 24rpx 24rpx 24rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #eee; }
.backBtn { min-width: 120rpx; }
.backText { font-size: 32rpx; color: #333; font-weight: 700; }
.title { font-size: 36rpx; font-weight: 700; }
.clearText { font-size: 26rpx; color: #f56c6c; }
.clearBtn.disabled .clearText { opacity: 0.4; }
.scroll { padding: 20rpx 24rpx; box-sizing: border-box; }
.scrollInner { max-width: 700rpx; margin: 0 auto; }
.empty { padding: 80rpx; text-align: center; }
.emptyText { color: #999; }
.row { display: flex; align-items: center; background: #fff; border-radius: 24rpx; padding: 20rpx; margin-bottom: 20rpx; }
.thumbWrap { width: 112rpx; height: 112rpx; border-radius: 56rpx; overflow: hidden; margin-right: 20rpx; background: #eee; }
.thumbImg { width: 100%; height: 100%; }
.thumbPlaceholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #999; }
.info { flex: 1; }
.name { font-size: 28rpx; font-weight: 600; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.price { font-size: 26rpx; color: #666; margin-top: 4rpx; display: block; }
.controls { display: flex; align-items: center; margin-top: 16rpx; }
.stepBtn { width: 52rpx; height: 52rpx; border-radius: 26rpx; border: 2rpx solid rgb(174,127,85); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; color: rgb(174,127,85); }
.stepBtnAdd { background: rgb(174,127,85); color: #fff; }
.qty { width: 56rpx; text-align: center; font-size: 28rpx; font-weight: 700; }
.removeBtn { margin-left: 20rpx; padding: 12rpx 20rpx; border-radius: 24rpx; background: #f7f7f7; }
.removeText { font-size: 24rpx; color: #666; }
.subTotal { font-size: 26rpx; font-weight: 700; color: #333; margin-left: 16rpx; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #eee; padding: 24rpx; display: flex; justify-content: space-between; align-items: center; }
.footerLine { font-size: 24rpx; color: #666; display: block; }
.footerTotal { font-size: 28rpx; color: #333; margin-top: 8rpx; display: block; }
.footerTotalNum { font-size: 36rpx; font-weight: 800; color: rgb(174,127,85); }
.payBtn { background: rgb(174,127,85); padding: 28rpx 48rpx; border-radius: 44rpx; color: #fff; font-size: 30rpx; font-weight: 700; }
.payBtn.disabled { opacity: 0.5; }
