/* pages/order/order.wxss */
.container { height: 100vh; display: flex; flex-direction: column; background: #f5f5f5; }
.tabBar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 28rpx 0;
  position: fixed;
  top: -1rpx;
  left: 0;
  right: 0;
  z-index: 999;
}
.tab { flex: 1; text-align: center; font-size: 28rpx; color: #999; position: relative; }
.tabActive { color: #ff9500; font-weight: 700; }
.tabActive::after { content: ''; position: absolute; bottom: 0; left: 20%; right: 20%; height: 4rpx; background: #ff9500; }
/* tabBar 固定后，为列表预留顶部空间，避免被遮挡 */
.scroll { flex: 1; padding: 140rpx 24rpx 48rpx; box-sizing: border-box; }
.scrollInner { max-width: 700rpx; margin: 0 auto; }
.empty { padding: 80rpx; text-align: center; }
.emptyText { color: #999; font-size: 28rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 24rpx; }
.cardTop { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.date { font-size: 26rpx; color: #666; }
.status { font-size: 26rpx; font-weight: 700; }
.itemRow { display: flex; margin-bottom: 20rpx; }
.itemThumbImg, .itemThumbPlaceholder { width: 144rpx; height: 144rpx; border-radius: 16rpx; margin-right: 20rpx; }
.itemThumbPlaceholder { background: #eee; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #999; }
.itemInfo { flex: 1; }
.itemName { font-size: 28rpx; color: #333; font-weight: 600; display: block; }
.itemOptions { font-size: 24rpx; color: #666; display: block; margin-top: 4rpx; }
.tag { font-size: 22rpx; color: #ff9500; background: #fff5e6; padding: 4rpx 12rpx; border-radius: 8rpx; margin-top: 8rpx; display: inline-block; }
.expandRow { margin-bottom: 16rpx; align-items: center; justify-content: center; }
.expandText { font-size: 24rpx; color: #666; }
.itemRowNotFirst { margin-top: 8rpx; }
.orderId { font-size: 28rpx; color: #999; margin-bottom: 8rpx; display: block; }
.amountBlock { text-align: right; margin-bottom: 24rpx; }
.totalAmount { font-size: 28rpx; color: #333; display: block; }
.payment { font-size: 28rpx; color: #666; }
.actions { display: flex; gap: 20rpx; margin-top: 8rpx; }
.actionBtn { padding: 16rpx 28rpx; border-radius: 36rpx; background: #f3f3f3; font-size: 24rpx; color: #333; font-weight: 700; }
.actionBtn.primary { background: #07c160; color: #fff; }
