<view class="container">
  <view class="tabBar">
    <view class="tab {{activeTab === 'all' ? 'tabActive' : ''}}" bindtap="setTab" data-key="all">全部</view>
    <view class="tab {{activeTab === 'pending_pay' ? 'tabActive' : ''}}" bindtap="setTab" data-key="pending_pay">待支付</view>
    <view class="tab {{activeTab === 'pending_pick' ? 'tabActive' : ''}}" bindtap="setTab" data-key="pending_pick">待取餐</view>
    <view class="tab {{activeTab === 'done' ? 'tabActive' : ''}}" bindtap="setTab" data-key="done">完成</view>
  </view>
  <scroll-view class="scroll" scroll-y>
    <view class="scrollInner">
      <view class="empty" wx:if="{{filteredOrders.length === 0}}">
        <text class="emptyText">{{emptyHint}}</text>
      </view>
      <view class="card" wx:for="{{filteredOrders}}" wx:key="id">
        <view class="cardTop">
          <text class="date">{{item.dateText}}</text>
          <text class="status" style="color: {{item.statusColor}}">{{item.status}}</text>
        </view>
        <view class="itemRow">
          <image class="itemThumbImg" src="{{item.firstImage}}" mode="aspectFill" wx:if="{{item.firstImage}}" />
          <view class="itemThumbPlaceholder" wx:else><text>图</text></view>
          <view class="itemInfo">
            <text class="itemName">{{item.firstName}}</text>
            <text class="itemOptions" wx:if="{{item.firstOptions}}">{{item.firstOptions}}</text>
            <text class="tag">{{item.serviceLabel}}</text>
          </view>
        </view>
        <view class="expandRow" wx:if="{{item.hasMore}}" bindtap="toggleExpand" data-id="{{item.id}}">
          <text class="expandText">{{item.expanded ? '收起商品' : '展开商品'}}</text>
        </view>
        <view class="extraItems" wx:if="{{item.expanded && item.hasMore}}">
          <view class="itemRow itemRowNotFirst" wx:for="{{item.extraItems}}" wx:for-item="sub" wx:key="id">
            <image class="itemThumbImg" src="{{sub.imagePath}}" mode="aspectFill" wx:if="{{sub.imagePath}}" />
            <view class="itemInfo"><text class="itemName">{{sub.name}}</text></view>
          </view>
        </view>
        <text class="orderId">订单号: {{item.id}}</text>
        <view class="amountBlock">
          <text class="totalAmount">订单金额: ¥{{item.totalPrice}}</text>
          <text class="payment">线上支付: ¥{{item.totalPrice}}</text>
        </view>
        <view class="actions">
          <view class="actionBtn" bindtap="goDetail" data-id="{{item.id}}">查看详情</view>
          <view class="actionBtn primary" wx:if="{{item.status === '待支付'}}" bindtap="payOrder" data-id="{{item.id}}">去支付</view>
          <view class="actionBtn primary" wx:if="{{item.status === '待取餐'}}" bindtap="confirmOrder" data-id="{{item.id}}">确认取餐</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
